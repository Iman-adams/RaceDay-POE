@using RaceDay.MVC.Services
@{
    // Who is logged in? (read from the session)
    var isLoggedIn = Context.Session.GetInt32(SessionKeys.UserId) != null;
    var role = Context.Session.GetString(SessionKeys.UserRole);
    var userName = Context.Session.GetString(SessionKeys.UserName) ?? "";

    // The first letters of the first two names, shown in the round badge (Mahmood Mohammad -> MM)
    var initials = string.Concat(userName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                         .Take(2).Select(part => char.ToUpper(part[0])));

    // Which page are we on? Used to highlight the matching menu item.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(bool isCurrent) => isCurrent ? "active" : "";
    string Current(bool isCurrent) => isCurrent ? "page" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["Page"] as string)">
    @* Every icon on the site is drawn ONCE here and reused with <svg class="icon"><use href="#i-name" /></svg> *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></symbol>
        <symbol id="i-route" viewBox="0 0 24 24"><circle cx="6" cy="19" r="3" /><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" /><circle cx="18" cy="5" r="3" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></symbol>
        <symbol id="i-flag" viewBox="0 0 24 24"><path d="M4 22V4M4 4h13l-2 4 2 4H4" /></symbol>
    </svg>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark rd-nav mb-4" aria-label="Main">
            <div class="container">
                @* Logged out: the brand goes to Log in. Logged in: it goes to the events page. *@
                <a class="rd-brand" href="@Url.Action(isLoggedIn ? "Index" : "Login", isLoggedIn ? "Home" : "Account")">
                    @* The logo: two forward chevrons on a violet tile *@
                    <svg class="rd-logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#8B5CF6" /><path d="M9 9l7 7-7 7M16 9l7 7-7 7" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <span class="text">Race<span>Day</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainMenu">
                    <ul class="navbar-nav me-auto ms-md-3 gap-md-1">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Home")" aria-current="@Current(controller == "Home")" asp-controller="Home" asp-action="Index">Events</a>
                            </li>
                        }

                        @* Each role gets its own menu items *@
                        @if (role == RoleNames.Organiser)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Organiser" && action == "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Organiser" && action != "Dashboard")" asp-controller="Organiser" asp-action="Events">My Events</a>
                            </li>
                        }
                        else if (role == RoleNames.Participant)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Participant" && (action == "MyEvents" || action == "Enrol" || action == "CancelEnrolment"))" asp-controller="Participant" asp-action="MyEvents">My Enrolments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Participant" && action == "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Participant" && action == "Profile")" asp-controller="Participant" asp-action="Profile">Profile</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-md-center gap-md-2">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item d-flex align-items-center gap-2 py-2 py-md-0">
                                <span class="rd-avatar" aria-hidden="true">@initials</span>
                                <span class="rd-user">@userName <small>@role</small></span>
                            </li>
                            <li class="nav-item">
                                @* Logging out changes data, so it is a POST form (not a plain link) *@
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active(controller == "Account" && action == "Login")" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @* One-off messages such as "You have been logged out." *@
            @if (TempData["Success"] is string successMessage)
            {
                <p role="status" class="alert alert-success">@successMessage</p>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <p role="alert" class="alert alert-danger">@errorMessage</p>
            }
            @if (TempData["Info"] is string infoMessage)
            {
                <p role="status" class="alert alert-info">@infoMessage</p>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2026 RaceDay &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>